# Ssh private keys needed by the git integration tests to access the sample repositories
# on github (drop-project-edu/sampleJavaAssignment and drop-project-edu/sampleJavaSubmission).
#
# The easiest setup is to download the ready-made file (this creates the git-ignored .env):
#
#   curl -s https://dropproject.org/drop-project-test.env -o .env
#
# Alternatively, copy this file to .env and paste the keys between the quotes, keeping
# the quotes - the values span multiple lines.
#
# The keys cannot be distributed inside the repository: github automatically revokes any
# private key that it finds published there, even when the exposure is intentional (these
# keys are read-only deploy keys for the public sample repositories, so publishing them
# is harmless - github's scanners just don't make exceptions).
#
# Without these keys you can still run the test suite without the tests that reach
# github.com or run real maven builds:  mvn test -Pfast

DP_SAMPLE_JAVA_ASSIGNMENT_PRIVATE_KEY=""

DP_SAMPLE_JAVA_SUBMISSION_PRIVATE_KEY=""
